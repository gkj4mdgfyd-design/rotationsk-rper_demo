# Anthropic API-Key fuer die KI-gestuetzte Erkennung von Vokabeln/Begriffen
# aus hochgeladenen Fotos und PDFs. Key erstellen unter: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Geheimer Schluessel zum Signieren der Login-Session (beliebige lange Zufallszeichenkette)
JWT_SECRET=bitte-durch-einen-eigenen-zufaelligen-wert-ersetzen

# Port, auf dem der Server laeuft
PORT=3000
